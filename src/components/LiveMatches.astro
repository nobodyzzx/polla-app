---
// Tarjeta(s) de partido EN VIVO con puntos provisionales del jugador.
// El contenedor arranca oculto; un script hace polling a /api/live y lo rellena.
// Reutilizable: se incluye en el dashboard y en La Polla.
---

<div id="live-container" class="hidden"></div>

<script>
  import { spanishName, isoForTeam } from '@/lib/isoFlags';

  function flagFromISO(iso: string): string {
    if (!iso) return '';
    const code = iso.includes('-') ? iso.split('-')[0] : iso;
    const base = 0x1f1e6 - 65;
    if (code.length < 2) return '';
    return String.fromCodePoint(code.charCodeAt(0) + base, code.charCodeAt(1) + base);
  }

  interface LiveMatch {
    id: string;
    home_team: string; away_team: string;
    home_score: number | null; away_score: number | null;
    home_pen: number | null; away_pen: number | null;
    minute: number | null; status: string;
    stage: string; round: string | null; group_name: string | null;
    myPoints: number | null; hasPrediction: boolean;
  }

  function minuteLabel(m: LiveMatch): string {
    if (m.status === 'PAUSED') return 'Entretiempo';
    if (m.minute != null) return `${m.minute}'`;
    return 'En vivo';
  }

  function stageLabel(m: LiveMatch): string {
    if (m.stage === 'group') return m.group_name ? `Grupo ${m.group_name}` : '';
    return m.round ?? '';
  }

  function pointsBadge(m: LiveMatch): string {
    if (!m.hasPrediction || m.myPoints == null) {
      return `<span class="text-xs text-slate-500">Sin pronóstico</span>`;
    }
    const p = m.myPoints;
    const color = p >= 6 ? 'text-gold' : p >= 3 ? 'text-gol' : p >= 1 ? 'text-slate-200' : 'text-slate-500';
    const verb = p > 0 ? 'Vas ganando' : 'Vas ganando';
    return `<span class="text-xs text-slate-400">${verb}</span> <span class="font-display text-lg ${color} tabular-nums">+${p}</span> <span class="text-xs text-slate-500">pts</span>`;
  }

  function card(m: LiveMatch): string {
    const hf = flagFromISO(isoForTeam(m.home_team) ?? '');
    const af = flagFromISO(isoForTeam(m.away_team) ?? '');
    const label = stageLabel(m);
    const penLine = m.home_pen != null
      ? `<div class="text-xs text-gold/70 mt-0.5">(${m.home_pen}–${m.away_pen} pen)</div>` : '';
    return `
      <div class="relative overflow-hidden rounded-2xl border border-fifared/40 bg-gradient-to-br from-brand-900 to-brand-800/40">
        <div class="flex items-center justify-between px-4 py-2.5 border-b border-brand-700/50">
          <span class="flex items-center gap-2">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-fifared opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-fifared"></span>
            </span>
            <span class="text-xs font-bold text-fifared uppercase tracking-wide">En vivo</span>
            ${label ? `<span class="text-xs text-slate-500">· ${label}</span>` : ''}
          </span>
          <span class="text-xs font-semibold text-white tabular-nums">${minuteLabel(m)}</span>
        </div>
        <div class="flex items-center justify-center gap-4 px-4 py-3">
          <div class="flex-1 text-right min-w-0">
            <span class="text-sm font-semibold text-white">${flagWrap(hf)} ${spanishName(m.home_team)}</span>
          </div>
          <div class="text-center flex-shrink-0">
            <div class="font-display text-3xl text-white leading-none tabular-nums">${m.home_score ?? 0} – ${m.away_score ?? 0}</div>
            ${penLine}
          </div>
          <div class="flex-1 text-left min-w-0">
            <span class="text-sm font-semibold text-white">${spanishName(m.away_team)} ${flagWrap(af)}</span>
          </div>
        </div>
        <div class="px-4 py-2.5 border-t border-brand-700/50 text-center">
          ${pointsBadge(m)}
        </div>
      </div>`;
  }

  function flagWrap(flag: string): string {
    return flag ? `<span style="font-family:'Twemoji Country Flags',sans-serif">${flag}</span>` : '';
  }

  async function refreshLive() {
    const container = document.getElementById('live-container');
    if (!container) return;
    try {
      const res = await fetch('/api/live');
      if (!res.ok) return;
      const { matches } = await res.json() as { matches: LiveMatch[] };
      if (!matches || matches.length === 0) {
        container.classList.add('hidden');
        container.innerHTML = '';
        return;
      }
      container.innerHTML = `<div class="space-y-3">${matches.map(card).join('')}</div>`;
      container.classList.remove('hidden');
    } catch { /* silencioso: la próxima vuelta reintenta */ }
  }

  let liveTimer: number | undefined;
  function initLive() {
    refreshLive();
    if (liveTimer) window.clearInterval(liveTimer);
    // Poll cada 45s: el sync de marcadores corre por cron; más frecuente no aporta.
    liveTimer = window.setInterval(refreshLive, 45000);
  }

  document.addEventListener('astro:page-load', initLive);
  // Detiene el polling al salir de la página (ClientRouter).
  document.addEventListener('astro:before-swap', () => {
    if (liveTimer) window.clearInterval(liveTimer);
  });
</script>
