---
import Layout from '@/layouts/Layout.astro';
import TeamName from '@/components/TeamName.astro';
import { createRequestClient, supabaseAdmin } from '@/lib/supabase';
import { spanishName, isoForTeam } from '@/lib/isoFlags';
import { isPlaceholderName } from '@/lib/match-link';

const accessToken = Astro.cookies.get('sb-access-token')?.value;
const refreshToken = Astro.cookies.get('sb-refresh-token')?.value;
if (!accessToken || !refreshToken) { Astro.cookies.delete('sb-access-token', { path: '/' }); Astro.cookies.delete('sb-refresh-token', { path: '/' }); return Astro.redirect('/login'); }

const supabase = createRequestClient(); // sesión aislada por petición (ver lib/supabase)
const { data: { user } } = await supabase.auth.setSession({ access_token: accessToken, refresh_token: refreshToken });
if (!user) { Astro.cookies.delete('sb-access-token', { path: '/' }); Astro.cookies.delete('sb-refresh-token', { path: '/' }); return Astro.redirect('/login'); }

const { data: navProfile } = await supabase
  .from('profiles').select('username, puntos_totales, es_referi, participa').eq('id', user.id).single();

// Página de jugador: quien no participa (admin puro) no tiene llave.
if (navProfile && navProfile.participa === false) return Astro.redirect('/dashboard');

const [{ data: koMatches }, { data: myPreds }] = await Promise.all([
  supabaseAdmin.from('matches')
    .select('id, home_team, away_team, home_score, away_score, home_pen, away_pen, winner_penalties, is_finished, round, match_number, match_date')
    .eq('stage', 'knockout')
    .order('match_number', { ascending: true }),
  supabaseAdmin.from('predictions')
    .select('match_id, user_home, user_away, user_home_pen, user_away_pen, user_winner_penalties, points_earned')
    .eq('user_id', user.id),
]);

const predByMatch = new Map((myPreds ?? []).map((p: any) => [p.match_id, p]));

// Quién clasifica: por penales si los hubo, si no por marcador (null si empate sin definir).
function qualifier(h: number | null, a: number | null, penW: string | null): 'home' | 'away' | null {
  if (h == null || a == null) return null;
  if (h > a) return 'home';
  if (a > h) return 'away';
  return (penW as 'home' | 'away' | null) ?? null;
}
// Clasificado que pronosticó el usuario (empate → ganador de penales pronosticado).
function predQualifier(p: any): 'home' | 'away' | null {
  if (!p || p.user_home == null || p.user_away == null) return null;
  if (p.user_home > p.user_away) return 'home';
  if (p.user_away > p.user_home) return 'away';
  if (p.user_home_pen != null && p.user_away_pen != null && p.user_home_pen !== p.user_away_pen)
    return p.user_home_pen > p.user_away_pen ? 'home' : 'away';
  return (p.user_winner_penalties as 'home' | 'away' | null) ?? null;
}

type KoView = {
  id: string; round: string; match_number: number;
  home: string; away: string; defined: boolean;
  home_score: number | null; away_score: number | null;
  home_pen: number | null; away_pen: number | null; winner_penalties: string | null;
  is_finished: boolean;
  actualQ: 'home' | 'away' | null;
  predQ: 'home' | 'away' | null; hasPred: boolean;
  points: number | null;
  status: 'undefined' | 'upcoming' | 'correct' | 'wrong' | 'nopred';
};

const eliminated = new Set<string>();
const alive = new Set<string>();
const backed = new Set<string>();

const views: KoView[] = (koMatches ?? []).map((m: any) => {
  const defined = !isPlaceholderName(m.home_team) && !isPlaceholderName(m.away_team);
  const pred = predByMatch.get(m.id);
  const actualQ = m.is_finished ? qualifier(m.home_score, m.away_score, m.winner_penalties) : null;
  const predQ = predQualifier(pred);
  const hasPred = !!pred && pred.user_home != null;

  if (defined) {
    alive.add(m.home_team); alive.add(m.away_team);
    if (m.is_finished && actualQ) {
      eliminated.add(actualQ === 'home' ? m.away_team : m.home_team);
    }
    if (hasPred && predQ) backed.add(predQ === 'home' ? m.home_team : m.away_team);
  }

  let status: KoView['status'];
  if (!defined) status = 'undefined';
  else if (!m.is_finished) status = 'upcoming';
  else if (!hasPred) status = 'nopred';
  else status = predQ === actualQ ? 'correct' : 'wrong';

  return {
    id: m.id, round: m.round, match_number: m.match_number,
    home: m.home_team, away: m.away_team, defined,
    home_score: m.home_score, away_score: m.away_score,
    home_pen: m.home_pen, away_pen: m.away_pen, winner_penalties: m.winner_penalties,
    is_finished: m.is_finished, actualQ, predQ, hasPred,
    points: pred?.points_earned ?? null, status,
  };
});

for (const t of eliminated) alive.delete(t);
// Equipos que respaldaste que siguen vivos / ya cayeron.
const misVivos = [...backed].filter((t) => alive.has(t));
const misCaidos = [...backed].filter((t) => eliminated.has(t));

// Métricas resumen.
const finishedDefined = views.filter((v) => v.defined && v.is_finished);
const predictedFinished = finishedDefined.filter((v) => v.hasPred);
const clasificadosOk = predictedFinished.filter((v) => v.status === 'correct').length;
const ptsKnockout = views.reduce((s, v) => s + (v.points ?? 0), 0);

const ROUND_LABEL: Record<string, string> = {
  R32: 'Dieciseisavos', R16: 'Octavos', Cuartos: 'Cuartos de final',
  Semifinal: 'Semifinales', 'Tercer Puesto': 'Tercer puesto', Final: 'Final',
};
const ROUND_ORDER = ['R32', 'R16', 'Cuartos', 'Semifinal', 'Tercer Puesto', 'Final'];
const byRound = ROUND_ORDER
  .map((r) => ({ round: r, label: ROUND_LABEL[r] ?? r, matches: views.filter((v) => v.round === r) }))
  .filter((g) => g.matches.length > 0);

function qName(v: KoView, q: 'home' | 'away' | null): string {
  if (!q) return '—';
  return spanishName(q === 'home' ? v.home : v.away);
}
function statusChip(v: KoView): { txt: string; cls: string } {
  switch (v.status) {
    case 'correct':  return { txt: '✅ Acertaste', cls: 'text-gol' };
    case 'wrong':    return { txt: '❌ Fallaste', cls: 'text-fifared' };
    case 'upcoming': return { txt: '⏳ Por jugar', cls: 'text-slate-500' };
    case 'nopred':   return { txt: 'Sin pronóstico', cls: 'text-slate-600' };
    default:         return { txt: '🔒 Rival por definir', cls: 'text-slate-600' };
  }
}
---

<Layout title="Mi Llave" navProfile={navProfile} isAuthed={true}>
  <div class="max-w-3xl mx-auto space-y-6">

    <div>
      <h1 class="font-display text-4xl text-white tracking-wide">MI LLAVE</h1>
      <p class="text-slate-500 text-sm mt-1">Tu bracket de eliminatorias: a quién pusiste como clasificado en cada cruce vs. la realidad.</p>
    </div>

    <!-- Resumen -->
    <div class="grid grid-cols-3 gap-3">
      <div class="rounded-2xl border border-brand-700/60 bg-brand-900 px-4 py-3 text-center">
        <p class="font-display text-3xl text-gol leading-none">{clasificadosOk}<span class="text-sm text-slate-600">/{predictedFinished.length}</span></p>
        <p class="text-[10px] text-slate-500 uppercase tracking-wide mt-1">Clasificados ok</p>
      </div>
      <div class="rounded-2xl border border-brand-700/60 bg-brand-900 px-4 py-3 text-center">
        <p class="font-display text-3xl text-gold leading-none">{ptsKnockout}</p>
        <p class="text-[10px] text-slate-500 uppercase tracking-wide mt-1">Puntos KO</p>
      </div>
      <div class="rounded-2xl border border-brand-700/60 bg-brand-900 px-4 py-3 text-center">
        <p class="font-display text-3xl text-white leading-none">{misVivos.length}</p>
        <p class="text-[10px] text-slate-500 uppercase tracking-wide mt-1">Tus vivos</p>
      </div>
    </div>

    <!-- Tus picks que siguen vivos -->
    {(misVivos.length > 0 || misCaidos.length > 0) && (
      <div class="rounded-2xl border border-brand-700/60 bg-brand-900 p-4 space-y-3">
        {misVivos.length > 0 && (
          <div>
            <p class="text-xs text-gol uppercase tracking-wide font-semibold mb-2">🟢 Siguen vivos de tus picks</p>
            <div class="flex flex-wrap gap-2">
              {misVivos.map((t) => (
                <span class="inline-flex items-center gap-1.5 text-sm bg-gol/10 border border-gol/30 text-slate-200 rounded-full px-3 py-1">
                  <span class="flag-emoji" data-iso={isoForTeam(t)}></span>{spanishName(t)}
                </span>
              ))}
            </div>
          </div>
        )}
        {misCaidos.length > 0 && (
          <div>
            <p class="text-xs text-slate-500 uppercase tracking-wide font-semibold mb-2">⚫ Ya cayeron</p>
            <div class="flex flex-wrap gap-2">
              {misCaidos.map((t) => (
                <span class="inline-flex items-center gap-1.5 text-sm bg-brand-800/50 border border-brand-700/50 text-slate-500 line-through rounded-full px-3 py-1">
                  <span class="flag-emoji" data-iso={isoForTeam(t)}></span>{spanishName(t)}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    )}

    <!-- Rondas -->
    {byRound.map((g) => (
      <section class="space-y-3">
        <h2 class="font-display text-2xl text-white tracking-wide">{g.label}</h2>
        <div class="grid gap-2 sm:grid-cols-2">
          {g.matches.map((v) => {
            const chip = statusChip(v);
            const winner = v.actualQ;
            return (
              <div class={`rounded-2xl border p-4 ${v.status === 'correct' ? 'border-gol/30 bg-gol/5' : v.status === 'wrong' ? 'border-fifared/25 bg-fifared/5' : 'border-brand-700/60 bg-brand-900'}`}>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-[10px] text-slate-600 uppercase tracking-wide">Partido {v.match_number}</span>
                  <span class={`text-xs font-semibold ${chip.cls}`}>{chip.txt}{v.points != null && v.is_finished ? ` · +${v.points}` : ''}</span>
                </div>

                {v.defined ? (
                  <div class="flex items-center justify-center gap-3">
                    <div class="flex-1 min-w-0">
                      <TeamName team={v.home} side="home" class={`text-sm font-semibold ${winner === 'home' ? 'text-gold' : winner === 'away' ? 'text-slate-500 line-through' : 'text-white'}`} />
                    </div>
                    <div class="text-center min-w-[52px] flex-shrink-0">
                      {v.is_finished ? (
                        <div class="font-display text-2xl text-white leading-none">{v.home_score}–{v.away_score}</div>
                      ) : (
                        <div class="font-display text-lg text-slate-500 leading-none">vs</div>
                      )}
                      {v.winner_penalties && v.home_pen != null && (
                        <div class="text-[11px] text-gold/70 leading-none mt-0.5">({v.home_pen}–{v.away_pen} pen)</div>
                      )}
                    </div>
                    <div class="flex-1 min-w-0">
                      <TeamName team={v.away} side="away" class={`text-sm font-semibold ${winner === 'away' ? 'text-gold' : winner === 'home' ? 'text-slate-500 line-through' : 'text-white'}`} />
                    </div>
                  </div>
                ) : (
                  <p class="text-center text-sm text-slate-600 py-1">Cruce por definir</p>
                )}

                {v.defined && (
                  <div class="mt-3 pt-2.5 border-t border-brand-800/60 flex items-center justify-between gap-2 text-xs">
                    <span class="text-slate-500">Tu pase:</span>
                    <span class={`font-semibold ${
                      v.status === 'correct' ? 'text-gol' :
                      v.status === 'wrong' ? 'text-fifared line-through' :
                      v.hasPred ? 'text-slate-200' : 'text-slate-600'
                    }`}>
                      {v.hasPred ? qName(v, v.predQ) : '— sin pronóstico'}
                    </span>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </section>
    ))}

  </div>
</Layout>

<script>
  // Rellena las banderas de los <TeamName/> y los chips (.flag-emoji con data-iso).
  function flagFromISO(iso: string): string {
    if (!iso) return '';
    const code = iso.includes('-') ? iso.split('-')[0] : iso;
    const base = 0x1f1e6 - 65;
    if (code.length < 2) return '';
    return String.fromCodePoint(code.charCodeAt(0) + base, code.charCodeAt(1) + base);
  }
  function initFlags() {
    document.querySelectorAll<HTMLSpanElement>('.flag-emoji').forEach((el) => {
      const iso = el.dataset.iso;
      if (iso) el.textContent = flagFromISO(iso);
    });
  }
  initFlags();
  document.addEventListener('astro:page-load', initFlags);
</script>
